        {
          "id": "cde36444-50fa-49b8-90dc-3135211a39f9",
          "name": "Enrich a batch of universal transactions",
          "request": {
            "name": "Enrich a batch of universal transactions",
            "description": {
              "content": "Submit a batch of universal transactions for enrichment.\nThis endpoint will return a `batchId` which can be used in the `/batches/{batchId}` and `/batches/{batchId}/results`\nendpoints to check the status of the batch job and retrieve the results.\n\nYou can pass `?synchronous=true` to enrich smaller sets of transactions synchronously. See the [Microbatch enrichment guide](https://docs.spade.com/reference/microbatch-enrichment-guide) for details.\n\nNote that we impose a rate limit on the number of batch requests made in a rolling 12 hour window. Please reach out to\nsales@spade.com with any questions.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "batches",
                "transactions",
                "universal",
                "enrich"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "synchronous",
                  "value": "false",
                  "description": "When `true`, returns enriched results inline in the response instead of a `batchId`. Microbatches are capped to ensure timely processing. See the [Microbatch enrichment guide](https://docs.spade.com/reference/microbatch-enrichment-guide) for details.\n"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
