        {
          "id": "3c5141b4-574e-45e9-8dfc-672b5c4caf7e",
          "name": "Enrich a batch of transfers",
          "request": {
            "name": "Enrich a batch of transfers",
            "description": {
              "content": "Submit a batch of transfers for enrichment.\nThis endpoint will return a `batchId` which can be used in the `/batches/{batchId}` and `/batches/{batchId}/results`\nendpoints to check the status of the batch job and retrieve the results.\n\nYou can pass `?synchronous=true` to enrich smaller sets of transactions synchronously. See the [Microbatch enrichment guide](https://docs.spade.com/reference/microbatch-enrichment-guide) for details.\n\nNote that we impose a rate limit on the number of batch requests made in a rolling 12 hour window. Please reach out to\nsales@spade.com with any questions.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "batches",
                "transactions",
                "transfers",
                "enrich"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "synchronous",
                  "value": "false",
                  "description": "When `true`, returns enriched results inline in the response instead of a `batchId`. Microbatches are capped to ensure timely processing. See the [Microbatch enrichment guide](https://docs.spade.com/reference/microbatch-enrichment-guide) for details.\n"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
