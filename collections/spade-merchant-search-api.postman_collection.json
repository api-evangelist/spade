    "_postman_id": "ef247512-bbc5-471b-9f98-bfec87873214",
    "name": "Spade Merchant Search API",
    "description": "Documentation for Spade's card transaction enrichment API and related endpoints. We offer sandbox and production environments on both the east coast and west coast to enable ultra low latency enrichment for realtime applications. Each environment requires different API keys. To inquire about API keys, please contact your Spade representative or reach out to .",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-10-21T20:56:27.000Z",
    "updatedAt": "2026-10-21T20:56:27.000Z",
