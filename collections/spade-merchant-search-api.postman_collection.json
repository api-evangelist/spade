          "request": {
            "name": "Search for merchants",
            "description": {
              "content": "<Info>This endpoint is in beta. To request access, contact [sales@spade.com](mailto:sales@spade.com).</Info>\n\nSearch for merchants in Spade's merchant database by name.\n\nDesigned for powering autocomplete experiences, this endpoint returns up to five matching merchants with their name, logo, and website.\n\nTo learn more, read the [Merchant Search Guide](https://docs.spade.com/reference/merchant-search-guide).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "corporations"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "name",
                  "value": "<string>",
                  "description": "(Required) The name of the merchant you want to find"
                }
              ],
              "variable": []
            },
            "header": [
